(defwidget canvas_layout []
  (box :class "drafting-sheet"
       :orientation "vertical"
       :space-evenly false
    (box :class "margin-top-bar"
         :orientation "horizontal"
         :space-evenly false
      (box :class "margin-corner")
      (box :class "margin-ticks-h"
           :orientation "horizontal"
           :space-evenly true
           :hexpand true
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h"))
      (box :class "margin-corner"))
    (box :class "center-sheet"
         :orientation "horizontal"
         :space-evenly false
         :vexpand true
      (box :class "margin-ticks-v"
           :orientation "vertical"
           :space-evenly true
        (box :class "zone-tick-v")
        (box :class "zone-tick-v")
        (box :class "zone-tick-v")
        (box :class "zone-tick-v"))
      (box :class "inner-frame"
           :vexpand true
           :hexpand true
        (box :class "canvas-interior"
             :vexpand true
             :hexpand true
          (box :class "wallpaper-layer"
               :vexpand true
               :hexpand true
            (image :path wallpaper_path
                   :image-width 1920
                   :image-height 1080
                   :visible {wallpaper_path != ""}))))
      (box :class "margin-ticks-v"
           :orientation "vertical"
           :space-evenly true
        (box :class "zone-tick-v")
        (box :class "zone-tick-v")
        (box :class "zone-tick-v")
        (box :class "zone-tick-v")))
    (box :class "margin-bottom-bar"
         :orientation "horizontal"
         :space-evenly false
      (box :class "margin-corner")
      (box :class "margin-ticks-h"
           :orientation "horizontal"
           :space-evenly true
           :hexpand true
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h")
        (box :class "zone-tick-h"))
      (box :class "margin-corner"))))

(defwindow background
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "100%"
                      :anchor "top left")
  :stacking "bottom"
  :windowtype "desktop"
  :wm-ignore true
  (canvas_layout))
