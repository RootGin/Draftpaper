(defwidget canvas_layout []
  (box :class "drafting-sheet"
       :orientation "vertical"
       :space-evenly false
    (box :class "inner-frame"
         :vexpand true
         :hexpand true
      (box :class "canvas-interior"
           :vexpand true
           :hexpand true
        (box :class "wallpaper-layer"
             :vexpand true
             :hexpand true
          (image :path wallpaper_path
                 :image-width 1864
                 :image-height 1024
                 :visible {wallpaper_path != ""}))))))

(defwindow background
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "1864px"
                      :height "1024px"
                      :anchor "top left")
  :stacking "bottom"
  :windowtype "desktop"
  :wm-ignore true
  (canvas_layout))
