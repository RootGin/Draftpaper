(defwidget top-margin-widget []
  (box :class "top-margin-band"
       :orientation "h"
       :space-evenly false
    (box :class "side-corner left"
      (label :text ""))
    (box :class "margin-zones"
         :orientation "h"
         :space-evenly true
         :hexpand true
      (box :class "margin-zone zone-1"
        (box :class "zone-content"
             :halign "center"
             :valign "center"
             :orientation "h"
             :space-evenly false
             :spacing 6
          (for ws in workspaces
            (box :visible {ws.focused}
              (eventbox :onclick "python3 scripts/workspaces.py switch ${ws.id}"
                        :cursor "pointer"
                        :class "workspace-slot focused"
                (box :orientation "h"
                     :space-evenly false
                     :spacing 4
                  (label :class "workspace-num"
                         :text "${ws.name}")
                  (box :class "workspace-apps"
                       :orientation "h"
                       :space-evenly false
                       :spacing 2
                    (for app in {ws.apps}
                      (label :class "workspace-glyph"
                             :text "${app}")))))))))
      (box :class "margin-zone zone-2"
        (eventbox :onclick "python3 scripts/workspaces.py switch 2"
                  :cursor "pointer"
                  :class "zone-digit-button"
          (box :class "zone-content"
               :halign "center"
               :valign "center"
            (label :class "zone-digit"
                   :text "2"))))
      (box :class "margin-zone zone-3"
        (eventbox :onclick "python3 scripts/workspaces.py switch 3"
                  :cursor "pointer"
                  :class "zone-digit-button"
          (box :class "zone-content"
               :halign "center"
               :valign "center"
            (label :class "zone-digit"
                   :text "3"))))
      (box :class "margin-zone zone-4"
        (eventbox :onclick "python3 scripts/workspaces.py switch 4"
                  :cursor "pointer"
                  :class "zone-digit-button"
          (box :class "zone-content"
               :halign "center"
               :valign "center"
            (label :class "zone-digit"
                   :text "4"))))
      (box :class "margin-zone zone-5"
        (eventbox :onclick "python3 scripts/workspaces.py switch 5"
                  :cursor "pointer"
                  :class "zone-digit-button"
          (box :class "zone-content"
               :halign "center"
               :valign "center"
            (label :class "zone-digit"
                   :text "5"))))
      (box :class "margin-zone zone-6"
        (box :class "zone-content"
             :halign "center"
             :valign "center"
          (label :class "margin-alert"
                 :visible {alerts.urgent}
                 :text "${alerts.text}")
          (eventbox :visible {!alerts.urgent}
                    :onclick "python3 scripts/workspaces.py switch 6"
                    :cursor "pointer"
                    :class "zone-digit-button"
            (label :class "zone-digit"
                   :text "6")))))
    (box :class "side-corner right"
      (label :text ""))))

(defwindow top-margin
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "draftpaper-margin"
  (top-margin-widget))
