(defwidget top-margin-widget []
  (box :class "top-margin-band"
       :orientation "h"
       :space-evenly false
    (box :class "top-margin-left"
         :halign "start"
         :orientation "h"
         :space-evenly false
      (for ws in workspaces
        (eventbox :onclick "python3 scripts/workspaces.py switch ${ws.id}"
                  :cursor "pointer"
                  :class "workspace-cell ${ws.focused ? 'focused' : ''} ${ws.active ? 'occupied' : 'empty'}"
          (box :class "workspace-content"
               :orientation "h"
               :space-evenly false
               :spacing 4
            (label :class "workspace-num"
                   :text "${ws.name}")
            (box :class "workspace-apps"
                 :orientation "h"
                 :space-evenly false
                 :spacing 2
              (for app in {ws.apps}
                (label :class "workspace-glyph"
                       :text "${app}")))))))
    (box :class "top-margin-center"
         :hexpand true)
    (box :class "top-margin-right"
         :halign "end"
         :orientation "h"
         :space-evenly false
      (label :class "margin-alert"
             :visible {alerts.urgent}
             :text "${alerts.text}"))))

(defwindow top-margin
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "draftpaper-margin"
  (top-margin-widget))
