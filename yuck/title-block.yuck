(defwidget title_block []
  (box :class "title-block-window"
       :orientation "h"
       :space-evenly false
    (box :class "title-col-left"
         :orientation "v"
         :space-evenly false
      (box :class "tb-cell tb-time"
           :orientation "v"
           :space-evenly false
        (label :class "tb-label" :halign "start" :text "TIME")
        (label :class "tb-value tb-time-val" :halign "start" :text "${readings.time}"))
      (eventbox :onclick "draftpaper graph network 2>/dev/null || true"
        (box :class "tb-cell tb-network"
             :orientation "v"
             :space-evenly false
          (label :class "tb-label" :halign "start" :text "NETWORK")
          (label :class "tb-value" :halign "start" :text "${readings.network}"))))
    (box :class "title-col-right"
         :orientation "v"
         :space-evenly false
      (box :class "tb-row"
           :orientation "h"
           :space-evenly false
        (box :class "tb-cell tb-date"
             :orientation "v"
             :space-evenly false
          (label :class "tb-label" :halign "start" :text "DATE")
          (label :class "tb-value" :halign "start" :text "${readings.date}"))
        (box :class "tb-cell tb-sheet"
             :orientation "v"
             :space-evenly false
          (label :class "tb-label" :halign "start" :text "SHEET")
          (label :class "tb-value" :halign "start" :text "${readings.sheet}"))
        (eventbox :onclick "draftpaper schedule equipment 2>/dev/null || true"
          (box :class "tb-cell tb-project"
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "PROJECT")
            (label :class "tb-value" :halign "start" :text "${readings.project}"))))
      (box :class "tb-row"
           :orientation "h"
           :space-evenly false
        (eventbox :onclick "draftpaper graph power 2>/dev/null || true"
          (box :class "tb-cell tb-power"
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "POWER")
            (label :class "tb-value" :halign "start" :text "${readings.power}")))
        (eventbox :onclick "draftpaper graph battery 2>/dev/null || true"
          (box :class {readings.battery_alert ? "tb-cell tb-battery alert" : "tb-cell tb-battery"}
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "BATTERY")
            (label :class "tb-value" :halign "start" :text "${readings.battery_text}")))
        (eventbox :onclick "scripts/readings.py --cycle-profile"
          (box :class "tb-cell tb-profile"
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "PROFILE")
            (label :class "tb-value" :halign "start" :text "${readings.profile_text}")))
        (eventbox :onclick "draftpaper graph load 2>/dev/null || true"
          (box :class "tb-cell tb-cpumem"
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "CPU / MEMORY")
            (label :class "tb-value" :halign "start" :text "${readings.cpumem_text}"))))
      (box :class "tb-row"
           :orientation "h"
           :space-evenly false
        (eventbox :onclick "draftpaper graph temp 2>/dev/null || true"
          (box :class {readings.temp_alert ? "tb-cell tb-temp alert" : "tb-cell tb-temp"}
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "TEMPERATURE · FAN")
            (label :class "tb-value" :halign "start" :text "${readings.tempfan_text}")))
        (eventbox :onclick "draftpaper schedule processes 2>/dev/null || true"
          (box :class "tb-cell tb-processes"
               :orientation "v"
               :space-evenly false
            (label :class "tb-label" :halign "start" :text "PROCESSES")
            (label :class "tb-value" :halign "start" :text "${readings.processes}")))
        (box :class "tb-cell tb-drawn"
             :orientation "v"
             :space-evenly false
          (label :class "tb-label" :halign "start" :text "DRAWN")
          (label :class "tb-value" :halign "start" :text "${readings.drawn}"))))))

(defwindow title-block
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "0px"
                      :anchor "bottom right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (title_block))
