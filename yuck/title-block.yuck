(defwidget title_block []
  (box :class "title-block-window"
       :orientation "h"
       :space-evenly false
       :hexpand false
       :vexpand false
    (box :class "tb-col tb-col-left"
         :orientation "v"
         :space-evenly false
         :hexpand false
         :vexpand false
      (box :class "tb-cell tb-time"
           :orientation "v"
           :space-evenly false
           :hexpand false
           :vexpand false
        (label :class "tb-label" :halign "start" :valign "start" :text "TIME")
        (label :class "tb-value tb-time-val" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 5 :truncate true :text "${readings.time}"))
      (eventbox :onclick "draftpaper graph network 2>/dev/null || python3 scripts/graphs.py toggle network"
        (box :class "tb-cell tb-network"
             :orientation "v"
             :space-evenly false
             :hexpand false
             :vexpand false
          (label :class "tb-label" :halign "start" :valign "start" :text "NETWORK")
          (box :class "tb-valuebox"
               :orientation "h"
               :space-evenly false
               :halign "start"
               :valign "end"
               :vexpand true
            (label :class "tb-icon" :text "")
            (label :class "tb-value" :wrap false :limit-width 15 :truncate true :text "${readings.network}")))))
    (box :class "tb-col tb-col-right"
         :orientation "v"
         :space-evenly false
         :hexpand false
         :vexpand false
      (box :class "tb-row tb-row-0"
           :orientation "h"
           :space-evenly false
           :hexpand false
           :vexpand false
        (box :class "tb-cell tb-date"
             :orientation "v"
             :space-evenly false
             :hexpand false
             :vexpand false
          (label :class "tb-label" :halign "start" :valign "start" :text "DATE")
          (label :class "tb-value" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 15 :truncate true :text "${readings.date}"))
        (box :class "tb-cell tb-sheet"
             :orientation "v"
             :space-evenly false
             :hexpand false
             :vexpand false
          (label :class "tb-label" :halign "start" :valign "start" :text "SHEET")
          (label :class "tb-value" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 4 :truncate true :text "${readings.sheet}"))
        (eventbox :onclick "draftpaper schedule equipment 2>/dev/null || true"
          (box :class "tb-cell tb-project"
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "PROJECT")
            (label :class "tb-value" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 16 :truncate true :text "${readings.project}"))))
      (box :class "tb-row tb-row-1"
           :orientation "h"
           :space-evenly false
           :hexpand false
           :vexpand false
        (eventbox :onclick "draftpaper graph power 2>/dev/null || python3 scripts/graphs.py toggle power"
          (box :class "tb-cell tb-power"
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "POWER")
            (box :class "tb-valuebox"
                 :orientation "h"
                 :space-evenly false
                 :halign "start"
                 :valign "end"
                 :vexpand true
              (label :class "tb-icon" :text {readings.power == "mains" ? "" : ""})
              (label :class "tb-value" :wrap false :limit-width 8 :truncate true :text "${readings.power}"))))
        (eventbox :onclick "draftpaper graph battery 2>/dev/null || python3 scripts/graphs.py toggle battery"
          (box :class {readings.battery_alert ? "tb-cell tb-battery alert" : "tb-cell tb-battery"}
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "BATTERY")
            (label :class "tb-value" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 8 :truncate true :text "${readings.battery_text}")))
        (eventbox :onclick "scripts/readings.py --cycle-profile"
          (box :class "tb-cell tb-profile"
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "PROFILE")
            (label :class "tb-value tb-value-sm" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 10 :truncate true :text "${readings.profile_text}")))
        (eventbox :onclick "draftpaper graph load 2>/dev/null || python3 scripts/graphs.py toggle cpu"
          (box :class "tb-cell tb-cpumem"
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "CPU / MEMORY")
            (label :class "tb-value tb-value-sm" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 12 :truncate true :text "${readings.cpumem_text}"))))
      (box :class "tb-row tb-row-2"
           :orientation "h"
           :space-evenly false
           :hexpand false
           :vexpand false
        (eventbox :onclick "draftpaper graph temp 2>/dev/null || python3 scripts/graphs.py toggle temp"
          (box :class {readings.temp_alert ? "tb-cell tb-temp alert" : "tb-cell tb-temp"}
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "TEMPERATURE · FAN")
            (label :class "tb-value tb-temp-val" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 24 :truncate true :text "${readings.tempfan_text}")))
        (eventbox :onclick "bin/draftpaper-eww drawn-click"
                  :onrightclick "bin/draftpaper-eww drawn-click --right"
          (box :class "tb-cell tb-drawn"
               :orientation "v"
               :space-evenly false
               :hexpand false
               :vexpand false
            (label :class "tb-label" :halign "start" :valign "start" :text "DRAWN")
            (label :class "tb-value" :halign "start" :valign "end" :vexpand true :wrap false :limit-width 14 :truncate true :text "${readings.drawn}")))))))

(defwindow title-block
  :monitor 0
  :geometry (geometry :x "28px"
                      :y "28px"
                      :anchor "bottom right")
  :stacking "fg"
  :exclusive false
  :focusable false
  (title_block))
